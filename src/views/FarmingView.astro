---
import Base from "../layouts/Base.astro";
import Figure from "../components/Figure.astro";
import FlowDiagram from "../components/FlowDiagram.astro";
import Onward from "../components/Onward.astro";
import { pages, photo, type Locale } from "../data/load";
import { lx, t } from "../i18n/utils";

export interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const title = t(lang, "farming.title");
const farming = pages.farming;
---

<Base lang={lang} path="/farming/" title={title} description={t(lang, "farming.description")} section="farming">
  <div class="container">
    <header class="page-head">
      <h1>{title}</h1>
      <p class="lead">{lx(farming.intro, lang)}</p>
    </header>

    {
      farming.flow.length > 0 && (
        <section class="section flow-section" aria-labelledby="flow-title">
          <h2 id="flow-title">{t(lang, "farming.flow")}</h2>
          <FlowDiagram flow={farming.flow} lang={lang} />
        </section>
      )
    }

    <section class="section" aria-labelledby="practices-title">
      <h2 id="practices-title">{t(lang, "farming.practices")}</h2>
      <div class="practices">
        {
          farming.practices.map((practice) => {
            const p = photo(practice.photo);
            return (
              <article class:list={["practice", { "has-photo": p }]} id={practice.id || undefined} data-rise>
                <div class="text">
                  <h3>{lx(practice.title, lang)}</h3>
                  <p>{lx(practice.body, lang)}</p>
                </div>
                {p && <Figure photo={p} lang={lang} ratio="4 / 3" sizes="(min-width: 64rem) 560px, 100vw" />}
              </article>
            );
          })
        }
      </div>
    </section>
  </div>
  <Onward lang={lang} current="farming" />
</Base>

<style>
  .section > h2 {
    margin-block-end: var(--s-6);
    font-size: var(--step-4);
    font-weight: 560;
    letter-spacing: -0.015em;
  }

  :lang(kn) .section > h2 {
    font-size: var(--step-3);
    letter-spacing: 0;
  }

  .flow-section {
    padding-block-end: var(--s-8);
  }

  .practices {
    display: grid;
  }

  .practice {
    display: grid;
    gap: var(--s-4);
    padding-block: var(--s-6);
    border-block-start: 2px solid var(--ink);
    scroll-margin-block-start: calc(var(--header-h) + var(--s-4));
  }

  .text {
    display: grid;
    align-content: start;
    gap: var(--s-3);
  }

  h3 {
    font-size: var(--step-3);
    font-weight: 560;
    color: var(--accent);
  }

  /* A practice arrived at from the diagram is marked by its top rule. */
  .practice:target {
    border-block-start-color: var(--accent);
  }

  .practice:target h3 {
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 0.2em;
  }

  @media (min-width: 64rem) {
    .practice {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--s-7);
      align-items: start;
    }

    /* Alternate the photo side so the page reads down in a zigzag. */
    .practice.has-photo:nth-child(even) .text {
      order: 2;
    }
  }
</style>
