---
import Base from "../layouts/Base.astro";
import Chapters from "../components/Chapters.astro";
import EventCard from "../components/EventCard.astro";
import Facts from "../components/Facts.astro";
import HeroScene from "../components/HeroScene.astro";
import Onward from "../components/Onward.astro";
import ThenNow from "../components/ThenNow.astro";
import { events, kindTotal, pages, photo, plantTotal, plot, settings, type Locale } from "../data/load";
import { formatDate, localePath, lx, t } from "../i18n/utils";

export interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const home = pages.home;
const hero = photo(home.hero);
const then = photo(home.then);
const now = photo(home.now);
const latest = events.slice(-Math.max(0, home.latest_count)).reverse();

// Facts may carry figures computed from the planting map.
const fill = (text: string) =>
  text
    .replaceAll("{plants}", String(plantTotal))
    .replaceAll("{kinds}", String(kindTotal))
    .replaceAll("{date}", formatDate(plot.date, lang));
const facts = home.facts.map((fact) => ({
  label: lx(fact.label, lang),
  value: fill(lx(fact.value, lang)),
  note: fill(lx(fact.note, lang)),
}));
---

<Base lang={lang} path="/" image={hero?.src}>
  <HeroScene title={lx(settings.name, lang)} tagline={lx(settings.tagline, lang)} days={t(lang, "home.days")} since={home.since} />

  <section class="container opening" aria-labelledby="facts-title">
    <p class="intro" data-rise>{lx(home.intro, lang)}</p>
    {
      facts.length > 0 && (
        <>
          <h2 id="facts-title" class="visually-hidden">
            {t(lang, "home.facts")}
          </h2>
          <Facts facts={facts} />
        </>
      )
    }
  </section>

  {
    then && now && (
      <section class="container section" aria-labelledby="then-now-title">
        <h2 id="then-now-title" class="section-title" data-rise>
          {t(lang, "home.thenNow")}
        </h2>
        <ThenNow then={then} now={now} lang={lang} />
      </section>
    )
  }

  {
    home.chapters.length > 0 && (
      <section class="story" aria-labelledby="story-title">
        <div class="container">
          <h2 id="story-title" class="section-title" data-rise>
            {t(lang, "home.story")}
          </h2>
        </div>
        <Chapters chapters={home.chapters} events={events} lang={lang} />
      </section>
    )
  }

  {
    latest.length > 0 && (
      <section class="container section latest-section" aria-labelledby="latest-title">
        <div class="section-head">
          <h2 id="latest-title">{t(lang, "home.latest")}</h2>
          <a class="more" href={localePath("/story/", lang)}>
            {t(lang, "home.allStory")}
          </a>
        </div>
        <div class="latest">
          {latest.map((event) => (
            <EventCard event={event} lang={lang} />
          ))}
        </div>
      </section>
    )
  }

  <Onward lang={lang} current="home" />
</Base>

<style>
  .opening {
    display: grid;
    gap: var(--s-8);
    padding-block: var(--s-8) var(--s-7);
  }

  .intro {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 380;
    font-variation-settings: "SOFT" 100;
    line-height: 1.4;
    max-width: 40ch;
  }

  :lang(kn) .intro {
    font-size: var(--step-1);
    line-height: 1.75;
    max-width: 52ch;
  }

  .section-title {
    margin-block-end: var(--s-5);
    font-size: var(--step-4);
    font-weight: 560;
    letter-spacing: -0.015em;
  }

  :lang(kn) .section-title {
    font-size: var(--step-3);
    letter-spacing: 0;
  }

  .story {
    padding-block-start: var(--s-7);
  }

  /* The last band runs straight into the latest entries. */
  .latest-section {
    padding-block-start: var(--s-8);
  }

  .latest-section h2 {
    font-size: var(--step-3);
  }

  .more {
    font-weight: 700;
    text-decoration-color: var(--soil);
  }

  .latest {
    display: grid;
    gap: var(--s-7) var(--s-5);
  }

  @media (min-width: 40rem) and (max-width: 63.99rem) {
    .latest {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .intro {
      font-size: var(--step-3);
      line-height: 1.3;
      max-width: 34ch;
    }

    :lang(kn) .intro {
      font-size: var(--step-2);
      line-height: 1.65;
      max-width: 44ch;
    }

    .latest {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
