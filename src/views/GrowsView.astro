---
import Base from "../layouts/Base.astro";
import Figure from "../components/Figure.astro";
import Onward from "../components/Onward.astro";
import PlotMap from "../components/PlotMap.svelte";
import { emptyTotal, groups, kindTotal, pages, photo, plantCounts, plantTotal, plot, species, type Locale } from "../data/load";
import { formatDate, lx, t } from "../i18n/utils";

export interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const other: Locale = lang === "en" ? "kn" : "en";
const title = t(lang, "grows.title");
const grows = pages.grows;

const countOf = (id: string) => plantCounts.get(id) ?? 0;
const groupRows = groups
  .map((group) => {
    const kinds = species
      .filter((s) => s.group === group.id && countOf(s.id) > 0)
      .sort((a, b) => countOf(b.id) - countOf(a.id) || lx(a.name, lang).localeCompare(lx(b.name, lang)));
    return { ...group, kinds, count: kinds.reduce((sum, s) => sum + countOf(s.id), 0) };
  })
  .filter((group) => group.kinds.length > 0);

// The table's bars are drawn against the most planted kind.
const most = Math.max(1, ...plantCounts.values());

// Each sheet of the hand-drawn map, with what's on it.
const blocks = plot.blocks.map((block) => {
  const cells = block.rows.flat();
  const empty = cells.filter((cell) => cell === "empty").length;
  const planted = cells.filter((cell) => cell !== "." && cell !== "empty" && cell !== "house").length;
  return {
    name: lx(block.name, lang),
    rows: block.rows,
    stats: t(lang, "grows.blockStats", { rows: block.rows.length, plants: planted, empty }),
  };
});
const rowTotal = plot.blocks.reduce((sum, block) => sum + block.rows.length, 0);
const mapDate = formatDate(plot.date, lang);
---

<Base lang={lang} path="/grows/" title={title} description={t(lang, "grows.description")} section="grows">
  <div class="container">
    <header class="page-head">
      <h1>{title}</h1>
      <p class="lead">{lx(grows.intro, lang)}</p>
      <p class="figure-mark">
        <span class="big">{plantTotal}</span>
        <span>{t(lang, "grows.mark", { kinds: kindTotal, date: mapDate })}</span>
      </p>
    </header>

    <section class="section" aria-labelledby="map-title">
      <h2 id="map-title">{t(lang, "grows.map")}</h2>
      <p class="note">{t(lang, "grows.mapNote", { date: mapDate })}</p>
      <PlotMap
        client:load
        blocks={blocks}
        kinds={Object.fromEntries(species.map((s) => [s.id, { name: lx(s.name, lang), group: s.group }]))}
        groups={groupRows.map((g) => ({ id: g.id, name: lx(g.name, lang), color: g.color, count: g.count }))}
        labels={{
          key: t(lang, "grows.key"),
          showAll: t(lang, "grows.showAll"),
          empty: t(lang, "grows.empty"),
          house: t(lang, "grows.house"),
          mapLabel: t(lang, "grows.mapLabel", { plants: plantTotal, empty: emptyTotal, rows: rowTotal }),
          place: t(lang, "grows.place"),
          find: t(lang, "grows.find"),
          everyKind: t(lang, "grows.everyKind"),
          found: t(lang, "grows.found"),
          foundIn: t(lang, "grows.foundIn"),
          groupsTitle: t(lang, "grows.groupsTitle"),
        }}
      />
    </section>

    <section class="section" aria-labelledby="table-title">
      <h2 id="table-title">{t(lang, "grows.table")}</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">{t(lang, "grows.colPlant")}</th>
              <th scope="col" lang={other}>{t(lang, "grows.colOther")}</th>
              <th scope="col" class="num">{t(lang, "grows.colCount")}</th>
            </tr>
          </thead>
          {
            groupRows.map((group) => (
              <tbody>
                <tr class="group">
                  <th scope="rowgroup" colspan="2">
                    <span class="swatch" style={`background: ${group.color}`} aria-hidden="true" />
                    {lx(group.name, lang)}
                  </th>
                  <td class="num">
                    <span class="count-cell">
                      {group.count}
                      <span />
                    </span>
                  </td>
                </tr>
                {group.kinds.map((kind) => (
                  <tr>
                    <th scope="row">{lx(kind.name, lang)}</th>
                    <td lang={other}>{lx(kind.name, other)}</td>
                    <td class="num">
                      <span class="count-cell">
                        {countOf(kind.id)}
                        <span class="bar" aria-hidden="true">
                          <span
                            style={`inline-size: ${((countOf(kind.id) / most) * 100).toFixed(1)}%; background: ${group.color}`}
                          />
                        </span>
                      </span>
                    </td>
                  </tr>
                ))}
              </tbody>
            ))
          }
          <tfoot>
            <tr>
              <th scope="row" colspan="2">{t(lang, "grows.total")}</th>
              <td class="num">
                <span class="count-cell">
                  {plantTotal}
                  <span />
                </span>
              </td>
            </tr>
          </tfoot>
        </table>
      </div>
    </section>

    {
      grows.crops.length > 0 && (
        <section class="section" aria-labelledby="crops-title">
          <h2 id="crops-title">{t(lang, "grows.crops")}</h2>
          <div class="crops">
            {grows.crops.map((crop) => {
              const p = photo(crop.photo);
              return (
                <article class="crop">
                  {p && <Figure photo={p} lang={lang} ratio="4 / 3" sizes="(min-width: 64rem) 380px, (min-width: 40rem) 50vw, 100vw" />}
                  <h3>{lx(crop.name, lang)}</h3>
                  <p>{lx(crop.body, lang)}</p>
                </article>
              );
            })}
          </div>
        </section>
      )
    }
  </div>
  <Onward lang={lang} current="grows" />
</Base>

<style>
  .figure-mark {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-2) var(--s-4);
    margin-block-start: var(--s-3);
    font-size: var(--step-1);
  }

  .big {
    font-family: var(--font-display);
    font-size: var(--step-5);
    line-height: 1;
    color: var(--accent);
  }

  .section > h2 {
    margin-block-end: var(--s-3);
  }

  .note {
    margin-block-end: var(--s-5);
    color: var(--ink-2);
  }

  #table-title {
    margin-block-end: var(--s-5);
  }

  .table-wrap {
    max-inline-size: 52rem;
  }

  table {
    inline-size: 100%;
    border-collapse: collapse;
  }

  th,
  td {
    padding: var(--s-2) var(--s-3) var(--s-2) 0;
    border-block-end: 1px solid var(--rule);
    text-align: start;
    font-weight: 400;
    vertical-align: baseline;
  }

  thead th {
    font-weight: 700;
    border-block-end: 1px solid var(--rule-strong);
  }

  .group th,
  .group td {
    padding-block-start: var(--s-5);
    font-weight: 700;
    border-block-end: 1px solid var(--rule-strong);
  }

  .swatch {
    display: inline-block;
    inline-size: 0.8rem;
    block-size: 0.8rem;
    margin-inline-end: var(--s-2);
  }

  tbody td[lang] {
    color: var(--ink-2);
  }

  .num {
    padding-inline-end: 0;
  }

  /* The count with a bar of its size after it. */
  .count-cell {
    display: inline-grid;
    grid-template-columns: 3ch clamp(1.5rem, 30vw - 4.5rem, 14rem);
    align-items: center;
    gap: var(--s-2);
    text-align: end;
  }

  .bar {
    display: flex;
    block-size: 0.7rem;
  }

  .bar span {
    min-inline-size: 2px;
  }

  tfoot th,
  tfoot td {
    padding-block-start: var(--s-4);
    font-weight: 700;
    border-block-end: 0;
  }

  .crops {
    display: grid;
    gap: var(--s-7) var(--s-5);
    margin-block-start: var(--s-5);
  }

  .crop {
    display: grid;
    align-content: start;
    gap: var(--s-2);
  }

  .crop h3 {
    margin-block-start: var(--s-2);
  }

  @media (min-width: 40rem) {
    .crops {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .crops {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
