---
/**
 * The farm's story in chapters, each a band in a colour of the land. Inside a
 * chapter, the photographed moments from its months follow one another: on a
 * wide screen the photo stays in view and changes as each moment scrolls past;
 * on a phone the moments are cards to swipe through.
 */
import Figure from "./Figure.astro";
import { photo as photoOf, type Chapter, type FarmEvent, type Locale } from "../data/load";
import { formatDate, formatMonth, localePath, lx, t } from "../i18n/utils";

export interface Props {
  chapters: Chapter[];
  events: FarmEvent[];
  lang: Locale;
}

const { chapters, events, lang } = Astro.props;

// A different hill line along the top of each band.
const edges = [
  "M0 64 L0 40 C 180 10 330 8 520 30 C 700 52 860 18 1040 14 C 1220 10 1400 44 1600 26 L1600 64 Z",
  "M0 64 L0 22 C 220 40 380 52 600 30 C 820 8 980 6 1180 30 C 1340 48 1480 40 1600 18 L1600 64 Z",
  "M0 64 L0 34 C 160 18 340 46 560 40 C 760 34 900 8 1120 12 C 1320 16 1460 46 1600 36 L1600 64 Z",
  "M0 64 L0 16 C 200 12 420 46 640 44 C 860 42 1000 14 1240 20 C 1420 26 1520 44 1600 40 L1600 64 Z",
];

const bands = chapters.map((chapter, index) => {
  const steps = events
    .filter((event) => event.date >= chapter.start && event.date <= chapter.end)
    .map((event) => ({ event, photo: photoOf(event.photo) }))
    .filter((step) => step.photo);
  return {
    chapter,
    id: `chapter-${index + 1}`,
    edge: edges[index % edges.length],
    period: t(lang, "home.period", { from: formatMonth(chapter.start, lang), to: formatMonth(chapter.end, lang) }),
    steps: steps as { event: FarmEvent; photo: NonNullable<(typeof steps)[number]["photo"]> }[],
  };
});
---

<div class="chapters">
  {
    bands.map(({ chapter, id, edge, period, steps }) => (
      <section class:list={["chapter", `tone-${chapter.tone}`]} aria-labelledby={id} data-chapter>
        <svg class="edge" viewBox="0 0 1600 64" preserveAspectRatio="none" aria-hidden="true" focusable="false">
          <path d={edge} />
        </svg>
        <div class="container inner">
          <header class="head" data-rise>
            <p class="period">{period}</p>
            <h3 id={id}>{lx(chapter.title, lang)}</h3>
            <p class="body">{lx(chapter.body, lang)}</p>
          </header>

          {steps.length > 0 && (
            <div class="moments">
              <ol class="steps">
                {steps.map(({ event, photo }, i) => (
                  <li class:list={["step", { on: i === 0 }]} data-step={i}>
                    <Figure
                      photo={photo}
                      lang={lang}
                      class="step-photo"
                      ratio="4 / 5"
                      sizes="20rem"
                    />
                    <p class="date">
                      <time datetime={event.date}>{formatDate(event.date, lang)}</time>
                    </p>
                    <h4>
                      <a href={`${localePath("/story/", lang)}#${event.slug}`}>{lx(event.title, lang)}</a>
                    </h4>
                    <p>{lx(event.body, lang)}</p>
                  </li>
                ))}
              </ol>
              <div class="stage" aria-hidden="true">
                {steps.map(({ photo }, i) => (
                  <img
                    src={photo.small}
                    width={photo.width}
                    height={photo.height}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    class:list={{ on: i === 0 }}
                    data-step={i}
                  />
                ))}
              </div>
            </div>
          )}
        </div>
      </section>
    ))
  }
</div>

<script>
  // On a wide screen, the photo beside the moments follows the one in the
  // middle of the window.
  const wide = matchMedia("(min-width: 64rem)");
  for (const chapter of document.querySelectorAll<HTMLElement>("[data-chapter]")) {
    const steps = [...chapter.querySelectorAll<HTMLElement>(".step")];
    const shots = [...chapter.querySelectorAll<HTMLElement>(".stage img")];
    if (steps.length < 2) continue;

    const show = (index: number) => {
      steps.forEach((step, i) => step.classList.toggle("on", i === index));
      shots.forEach((shot, i) => shot.classList.toggle("on", i === index));
    };

    const watch = new IntersectionObserver(
      (entries) => {
        if (!wide.matches) return;
        for (const entry of entries) {
          if (entry.isIntersecting) show(Number((entry.target as HTMLElement).dataset.step));
        }
      },
      { rootMargin: "-48% 0px -48% 0px" },
    );
    steps.forEach((step) => watch.observe(step));
  }
</script>

<style>
  .chapter {
    position: relative;
    margin-block-start: 3.5rem;
    padding-block: var(--s-6) var(--s-8);
    background: var(--band);
    color: var(--band-ink);
  }

  .tone-soil {
    --band: var(--soil);
    --band-ink: var(--paper);
    --band-mark: var(--soil-pale);
  }

  .tone-paper {
    --band: var(--paper-2);
    --band-ink: var(--ink);
    --band-mark: var(--leaf);
  }

  .tone-turmeric {
    --band: var(--turmeric);
    --band-ink: var(--ink);
    --band-mark: var(--turmeric-deep);
  }

  .tone-forest {
    --band: var(--forest);
    --band-ink: var(--paper);
    --band-mark: var(--turmeric);
  }

  /* The band's top edge is a line of hills in its own colour. */
  .edge {
    position: absolute;
    inset-block-end: calc(100% - 1px);
    inset-inline: 0;
    inline-size: 100%;
    block-size: 3.5rem;
    fill: var(--band);
  }

  .inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-7);
  }

  .head {
    display: grid;
    gap: var(--s-4);
  }

  .period {
    font-weight: 700;
    color: var(--band-mark);
  }

  h3 {
    font-size: var(--step-5);
    font-weight: 560;
    font-variation-settings: "SOFT" 100, "WONK" 1;
    line-height: 0.95;
    letter-spacing: -0.02em;
  }

  :lang(kn) h3 {
    font-size: var(--step-4);
    line-height: 1.3;
    letter-spacing: 0;
  }

  .body {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 380;
    line-height: 1.5;
    max-width: 52ch;
  }

  a {
    color: inherit;
  }

  /* On a phone: cards in a row to swipe through. */
  .steps {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(78%, 20rem);
    gap: var(--s-4);
    margin: 0 calc(var(--gutter) * -1);
    padding: 0 var(--gutter) var(--s-4);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-color: var(--band-mark) transparent;
    list-style: none;
  }

  .step {
    display: grid;
    align-content: start;
    gap: var(--s-2);
    scroll-snap-align: start;
  }

  .step :global(.step-photo) {
    margin-block-end: var(--s-2);
  }

  .date {
    font-weight: 700;
    color: var(--band-mark);
  }

  h4 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 500;
    line-height: 1.15;
  }

  :lang(kn) h4 {
    line-height: 1.4;
  }

  h4 a {
    text-decoration-color: var(--band-mark);
  }

  .stage {
    display: none;
  }

  @media (min-width: 64rem) {
    .chapter {
      margin-block-start: 5rem;
      padding-block: var(--s-7) var(--s-9);
    }

    .edge {
      block-size: 5rem;
    }

    .head {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      column-gap: var(--s-7);
      align-items: end;
    }

    .period,
    h3 {
      grid-column: 1;
    }

    .head .body {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: end;
    }

    .moments {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--s-8);
    }

    /* The moments, one under another, each with time on screen. */
    .steps {
      grid-auto-flow: row;
      grid-auto-columns: auto;
      gap: 0;
      margin: 0;
      padding: 18vh 0;
      overflow: visible;
      scroll-snap-type: none;
    }

    .step {
      min-block-size: 42vh;
      align-content: center;
      padding-inline-start: var(--s-5);
      border-inline-start: 2px solid transparent;
      transition: border-color var(--quick) var(--ease);
    }

    .step.on {
      border-inline-start-color: var(--band-mark);
    }

    .step :global(.step-photo) {
      display: none;
    }

    .stage {
      display: block;
      position: sticky;
      inset-block-start: calc(var(--header-h) + var(--s-6));
      align-self: start;
      block-size: calc(100svh - var(--header-h) - var(--s-6) * 2);
      max-block-size: 52rem;
    }

    .stage img {
      position: absolute;
      inset: 0;
      inline-size: 100%;
      block-size: 100%;
      object-fit: cover;
      opacity: 0;
      transition: opacity var(--slow) var(--ease);
    }

    .stage img.on {
      opacity: 1;
    }
  }
</style>
