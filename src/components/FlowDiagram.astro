---
/**
 * Where the farm's inputs come from: what each source is made into, and what
 * that is used for. On a wide screen it's three columns joined by curves;
 * pointing at any box lights up the paths through it, and clicking jumps to
 * the practice that explains it. On a phone, and for screen readers, it's a
 * list of the same paths.
 */
import type { Flow, Locale } from "../data/load";
import { lx, t } from "../i18n/utils";

export interface Props {
  flow: Flow[];
  lang: Locale;
}

const { flow, lang } = Astro.props;
const paths = flow.map((f) => ({
  source: lx(f.source, lang),
  made: lx(f.made, lang),
  use: lx(f.use, lang),
  practice: f.practice,
}));

// Each column lists a box once, in the order the paths first use it.
const column = (key: "source" | "made" | "use") =>
  [...new Set(paths.map((p) => p[key]))].map((name) => ({
    name,
    practice: paths.find((p) => p[key] === name)?.practice ?? "",
    flows: paths.flatMap((p, i) => (p[key] === name ? [i] : [])).join(" "),
  }));
const columns = [
  { key: "source", label: t(lang, "farming.from"), nodes: column("source") },
  { key: "made", label: t(lang, "farming.via"), nodes: column("made") },
  { key: "use", label: t(lang, "farming.to"), nodes: column("use") },
] as const;
---

<div class="flow" data-flow>
  <ol class="flow-list">
    {
      paths.map((p) => (
        <li>
          <a href={`#${p.practice}`}>
            <span>{p.source}</span>
            <span class="arrow" aria-hidden="true">
              →
            </span>
            <span class="made">{p.made}</span>
            <span class="arrow" aria-hidden="true">
              →
            </span>
            <span>{p.use}</span>
          </a>
        </li>
      ))
    }
  </ol>

  <div class="diagram" aria-hidden="true">
    <svg class="links"></svg>
    {
      columns.map((col) => (
        <div class:list={["col", `col-${col.key}`]}>
          <p class="col-label">{col.label}</p>
          <div class="nodes">
            {col.nodes.map((node) => (
              <a class="node" href={`#${node.practice}`} tabindex="-1" data-col={col.key} data-flows={node.flows}>
                {node.name}
              </a>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</div>

<script>
  for (const flow of document.querySelectorAll<HTMLElement>("[data-flow]")) {
    const diagram = flow.querySelector<HTMLElement>(".diagram");
    const svg = flow.querySelector<SVGSVGElement>(".links");
    if (!diagram || !svg) continue;
    const nodes = [...diagram.querySelectorAll<HTMLElement>(".node")];
    const flowsOf = (node: HTMLElement) => (node.dataset.flows ?? "").split(" ");
    const count = Math.max(...nodes.flatMap((n) => flowsOf(n).map(Number))) + 1;

    // One curve per pair of boxes that a path joins, tagged with its paths.
    const draw = () => {
      if (getComputedStyle(diagram).display === "none") return;
      const box = diagram.getBoundingClientRect();
      svg.setAttribute("viewBox", `0 0 ${box.width} ${box.height}`);
      const parts: string[] = [];
      const curves = new Map<string, { d: string; flows: number[] }>();
      for (let i = 0; i < count; i++) {
        const chain = (["source", "made", "use"] as const).map((col) =>
          nodes.find((n) => n.dataset.col === col && flowsOf(n).includes(String(i))),
        );
        for (let j = 0; j < 2; j++) {
          const a = chain[j];
          const b = chain[j + 1];
          if (!a || !b) continue;
          const key = `${nodes.indexOf(a)}-${nodes.indexOf(b)}`;
          const ra = a.getBoundingClientRect();
          const rb = b.getBoundingClientRect();
          const x1 = ra.right - box.left;
          const y1 = ra.top + ra.height / 2 - box.top;
          const x2 = rb.left - box.left;
          const y2 = rb.top + rb.height / 2 - box.top;
          const mid = (x1 + x2) / 2;
          const curve = curves.get(key) ?? { d: `M${x1} ${y1} C${mid} ${y1} ${mid} ${y2} ${x2} ${y2}`, flows: [] };
          curve.flows.push(i);
          curves.set(key, curve);
        }
      }
      for (const { d, flows } of curves.values()) {
        parts.push(`<path d="${d}" data-flows="${flows.join(" ")}"></path>`);
      }
      svg.innerHTML = parts.join("");
    };

    const light = (flows: string[] | null) => {
      diagram.classList.toggle("lit", flows !== null);
      for (const el of [...nodes, ...svg.querySelectorAll<SVGPathElement>("path")]) {
        const on = flows !== null && (el.dataset.flows ?? "").split(" ").some((f) => flows.includes(f));
        el.classList.toggle("on", on);
      }
    };
    for (const node of nodes) {
      node.addEventListener("pointerenter", () => light(flowsOf(node)));
      node.addEventListener("pointerleave", () => light(null));
    }

    new ResizeObserver(draw).observe(diagram);
    document.fonts?.ready.then(draw);
  }
</script>

<style>
  .flow-list {
    display: grid;
    gap: var(--s-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .flow-list a {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--s-2);
    padding: var(--s-3) var(--s-4);
    background: var(--paper-2);
    text-decoration: none;
  }

  .flow-list a:hover .made {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }

  .made {
    font-weight: 700;
    color: var(--accent);
  }

  .arrow {
    color: var(--ink-2);
  }

  .diagram {
    display: none;
  }

  @media (min-width: 48rem) {
    /* The list stays for screen readers; the diagram shows instead. */
    .flow-list {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .diagram {
      position: relative;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(3rem, 8vw, 9rem);
    }

    .links {
      position: absolute;
      inset: 0;
      inline-size: 100%;
      block-size: 100%;
      overflow: visible;
      pointer-events: none;
      fill: none;
    }

    .links :global(path) {
      stroke: var(--rule-strong);
      stroke-width: 2;
      transition:
        stroke var(--quick) var(--ease),
        stroke-width var(--quick) var(--ease);
    }

    .lit .links :global(path.on) {
      stroke: var(--accent);
      stroke-width: 4;
    }

    .col {
      display: grid;
      grid-template-rows: auto 1fr;
      gap: var(--s-4);
    }

    .nodes {
      display: grid;
      align-content: center;
      gap: var(--s-4);
    }

    .col-label {
      font-weight: 700;
      color: var(--ink-2);
    }

    .node {
      position: relative;
      padding: var(--s-3) var(--s-4);
      border: 2px solid var(--ink);
      background: var(--paper);
      font-family: var(--font-display);
      font-size: var(--step-1);
      line-height: 1.3;
      text-decoration: none;
      transition:
        background-color var(--quick) var(--ease),
        color var(--quick) var(--ease);
    }

    .col-made .node {
      background: var(--turmeric);
      border-color: var(--turmeric);
      color: var(--ink);
    }

    .col-use .node {
      background: var(--leaf);
      border-color: var(--leaf);
      color: var(--paper);
    }

    .lit .node.on {
      background: var(--ink);
      border-color: var(--ink);
      color: var(--paper);
    }
  }
</style>
