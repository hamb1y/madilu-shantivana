---
/**
 * The home page's opening: the farm's name over a drawing of it. Ploughed red
 * rows run to the hills, with lines of trees either side, as in the June 2026
 * photos: timber and fruit rows, coconut down one side, banana at the far end.
 *
 * The drawing is made at build time. In the browser the trees grow in, lean
 * as the pointer moves across them, and the hills shift as the page scrolls;
 * none of it runs when the visitor prefers less motion.
 */
export interface Props {
  title: string;
  tagline: string;
  /** Sentence with a {days} placeholder, filled in again in the browser. */
  days: string;
  since: string;
}

const { title, tagline, days, since } = Astro.props;

const W = 1600;
const H = 900;
const HORIZON = 590;
// The drawing starts just above the highest hill; the page is the sky.
const TOP = 300;
const VP = { x: 800, y: HORIZON };

// A small seeded generator, so the drawing is the same on every build.
let seed = 20240616;
const rand = () => {
  seed = (seed * 1664525 + 1013904223) % 4294967296;
  return seed / 4294967296;
};
const pick = <T,>(list: T[]) => list[Math.floor(rand() * list.length)];
const r1 = (n: number) => Math.round(n * 10) / 10;

/** A smooth closed hill shape through the given crest points. */
function hill(points: [number, number][], bottom = H) {
  const p = points;
  let d = `M ${p[0][0]} ${bottom} L ${p[0][0]} ${p[0][1]}`;
  for (let i = 0; i < p.length - 1; i++) {
    const p0 = p[Math.max(0, i - 1)];
    const p1 = p[i];
    const p2 = p[i + 1];
    const p3 = p[Math.min(p.length - 1, i + 2)];
    const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
    const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
    d += ` C ${r1(c1[0])} ${r1(c1[1])} ${r1(c2[0])} ${r1(c2[1])} ${p2[0]} ${p2[1]}`;
  }
  return `${d} L ${p[p.length - 1][0]} ${bottom} Z`;
}

const far = hill([[0, 520], [120, 470], [260, 430], [380, 470], [520, 395], [640, 440], [760, 480], [880, 445], [1000, 400], [1130, 350], [1250, 420], [1380, 455], [1500, 410], [1600, 440]]);
const mid = hill([[0, 560], [150, 520], [330, 540], [470, 500], [600, 535], [720, 555], [860, 530], [980, 505], [1120, 540], [1260, 515], [1420, 545], [1600, 520]]);
const ridge = hill([[0, 592], [200, 572], [420, 584], [640, 570], [800, 580], [980, 568], [1200, 582], [1400, 570], [1600, 586]]);

// Ground: strips between lines that meet at the vanishing point.
const BOTTOM = H + 40;
const at = (bx: number, t: number) => ({ x: VP.x + (bx - VP.x) * t, y: VP.y + (BOTTOM - VP.y) * t });
const strips: { d: string; fill: string }[] = [];
const edges: number[] = [];
for (let x = -3400; x <= 5000; x += 200) edges.push(x);
const furrow = ["#b4532a", "#a5461f", "#b4532a", "#7e8f46"];
edges.slice(0, -1).forEach((bx, i) => {
  const nx = edges[i + 1];
  strips.push({
    d: `M ${VP.x} ${VP.y} L ${bx} ${BOTTOM} L ${nx} ${BOTTOM} Z`,
    fill: furrow[((i % furrow.length) + furrow.length) % furrow.length],
  });
});

// Lines of trees either side of the central avenue, by kind of row.
type Kind = "timber" | "fruit" | "palm" | "banana";
const rows: { offset: number; kind: Kind }[] = [
  { offset: -2100, kind: "palm" },
  { offset: -1450, kind: "timber" },
  { offset: -820, kind: "fruit" },
  { offset: -300, kind: "timber" },
  { offset: 300, kind: "timber" },
  { offset: 820, kind: "fruit" },
  { offset: 1450, kind: "timber" },
  { offset: 2100, kind: "banana" },
];

const greens = ["#36592f", "#40683a", "#4b7440", "#2f5129"];
const leafy = ["#5f8f45", "#6c9c4b", "#78a653"];

interface Tree {
  x: number;
  y: number;
  s: number;
  kind: Kind;
  delay: number;
  lean: number;
  tone: string;
  light: string;
  flip: boolean;
}

const trees: Tree[] = [];
for (const row of rows) {
  for (let j = 0; j < 22; j++) {
    const t = 1.25 / (1 + 0.42 * j);
    if (t < 0.06) break;
    const p = at(VP.x + row.offset, t);
    if (p.x < -200 || p.x > W + 200) continue;
    // Now and then a different kind, as on the real rows.
    const kind: Kind = rand() < 0.12 ? pick<Kind>(["fruit", "timber", "banana"]) : row.kind;
    trees.push({
      x: r1(p.x + (rand() - 0.5) * 30 * t),
      y: r1(p.y),
      s: Math.round(t * 1.1 * (0.85 + rand() * 0.3) * 1000) / 1000,
      kind,
      // Far trees grow first, then the near ones.
      delay: Math.round(200 + (1 - Math.min(t, 1)) * 400 + j * 15 + rand() * 120),
      lean: Math.round((0.6 + rand() * 0.8) * 100) / 100,
      tone: pick(greens),
      light: pick(leafy),
      flip: rand() < 0.5,
    });
  }
}
// Back to front.
trees.sort((a, b) => a.y - b.y);

const sinceTime = Date.parse(`${since}T00:00:00+05:30`);
const dayCount = Math.max(0, Math.floor((Date.now() - sinceTime) / 86400000));
const [daysBefore, daysAfter] = days.split("{days}");
---

<section class="hero" data-hero>
  <div class="hero-text container">
    <h1>{title}</h1>
    <p class="tagline">{tagline}</p>
    {
      days.includes("{days}") && (
        <p class="days">
          {daysBefore}
          <span class="count" data-since={sinceTime}>{dayCount}</span>
          {daysAfter}
        </p>
      )
    }
  </div>

  <svg class="scene" viewBox={`0 ${TOP} ${W} ${H - TOP}`} preserveAspectRatio="xMidYMax slice" aria-hidden="true" focusable="false">
    <g class="layer" data-depth="0.6">
      <circle class="sun" cx="1235" cy="372" r="58" fill="var(--turmeric)"></circle>
    </g>
    <g class="layer" data-depth="0.45"><path d={far} fill="var(--hill-far)"></path></g>
    <g class="layer" data-depth="0.25"><path d={mid} fill="var(--hill-mid)"></path></g>
    <g class="layer" data-depth="0.1"><path d={ridge} fill="var(--hill-near)"></path></g>
    <g class="ground">
      {strips.map((s) => <path d={s.d} fill={s.fill} />)}
    </g>
    <g class="trees">
      {
        trees.map((tree) => (
          <g transform={`translate(${tree.x} ${tree.y}) scale(${tree.flip ? -tree.s : tree.s} ${tree.s})`}>
            <g class="grow" style={`--d:${tree.delay}ms`}>
              <g class="sway" style={`--k:${tree.lean}`}>
                <ellipse cx="0" cy="0" rx={tree.kind === "palm" ? 18 : 30} ry="5" fill="#000" opacity="0.14" />
                {tree.kind === "timber" && (
                  <>
                    <path d="M -2.5 0 L -1.5 -150 L 1.5 -150 L 2.5 0 Z" fill="#5b4632" />
                    <ellipse cx="0" cy="-118" rx="24" ry="40" fill={tree.tone} />
                    <ellipse cx="-12" cy="-150" rx="17" ry="28" fill={tree.tone} />
                    <ellipse cx="9" cy="-172" rx="15" ry="24" fill={tree.light} />
                    <ellipse cx="7" cy="-112" rx="12" ry="20" fill={tree.light} opacity="0.7" />
                  </>
                )}
                {tree.kind === "fruit" && (
                  <>
                    <path d="M -4 0 L -3 -36 L 3 -36 L 4 0 Z" fill="#5b4632" />
                    <circle cx="-16" cy="-56" r="24" fill={tree.tone} />
                    <circle cx="16" cy="-58" r="25" fill={tree.tone} />
                    <circle cx="0" cy="-78" r="27" fill={tree.light} />
                    <circle cx="-10" cy="-50" r="4" fill="var(--turmeric)" />
                    <circle cx="14" cy="-66" r="4" fill="var(--turmeric)" />
                    <circle cx="4" cy="-44" r="3.5" fill="var(--turmeric)" />
                  </>
                )}
                {tree.kind === "palm" && (
                  <>
                    <path d="M -3 0 Q 6 -90 14 -190 L 19 -190 Q 10 -90 4 0 Z" fill="#7a6040" />
                    <g fill="none" stroke={tree.tone} stroke-width="7" stroke-linecap="round">
                      <path d="M 16 -190 Q -20 -205 -58 -170" />
                      <path d="M 16 -190 Q 50 -210 88 -172" />
                      <path d="M 16 -190 Q -10 -230 -40 -232" />
                      <path d="M 16 -190 Q 40 -235 70 -232" />
                      <path d="M 16 -190 Q 0 -170 -30 -138" />
                      <path d="M 16 -190 Q 34 -168 58 -136" />
                    </g>
                    <circle cx="16" cy="-184" r="6" fill="#8a6a2a" />
                  </>
                )}
                {tree.kind === "banana" && (
                  <>
                    <path d="M -5 0 L -4 -48 L 4 -48 L 5 0 Z" fill="#6f8a3c" />
                    <path d="M 0 -48 Q -48 -70 -66 -40 Q -36 -54 0 -46 Z" fill={tree.light} />
                    <path d="M 0 -48 Q 50 -76 70 -42 Q 38 -58 0 -46 Z" fill={tree.light} />
                    <path d="M 0 -48 Q -26 -110 -40 -118 Q -12 -86 2 -50 Z" fill={tree.tone} />
                    <path d="M 0 -48 Q 22 -116 40 -122 Q 16 -86 -2 -50 Z" fill={tree.tone} />
                    <path d="M 0 -48 Q -4 -110 4 -134 Q 8 -96 2 -48 Z" fill={tree.light} />
                  </>
                )}
              </g>
            </g>
          </g>
        ))
      }
    </g>
  </svg>
  <script is:inline>
    // Hide the trees before the first paint so they can grow in.
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
      document.currentScript.previousElementSibling.classList.add("unsown");
    }
  </script>
</section>

<script>
  const hero = document.querySelector<HTMLElement>("[data-hero]");
  const scene = hero?.querySelector<SVGSVGElement>(".scene");
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Keep the day count current, whenever the page was built.
  const count = hero?.querySelector<HTMLElement>("[data-since]");
  if (count) {
    const days = Math.floor((Date.now() - Number(count.dataset.since)) / 86400000);
    if (days > 0) count.textContent = String(days);
  }

  if (hero && scene && !still) {
    // Grow the trees and raise the sun.
    requestAnimationFrame(() => requestAnimationFrame(() => scene.classList.remove("unsown")));

    // Moving the pointer is a breeze: the trees lean with it and settle back.
    let settle = 0;
    let lastX: number | null = null;
    hero.addEventListener("pointermove", (event) => {
      if (lastX !== null) {
        const wind = Math.max(-7, Math.min(7, (event.clientX - lastX) * 0.6));
        scene.style.setProperty("--wind", `${wind}deg`);
      }
      lastX = event.clientX;
      window.clearTimeout(settle);
      settle = window.setTimeout(() => scene.style.setProperty("--wind", "0deg"), 140);
    });
    hero.addEventListener("pointerleave", () => {
      lastX = null;
      scene.style.setProperty("--wind", "0deg");
    });

    // The hills drift at their own depths as the page scrolls.
    const layers = [...scene.querySelectorAll<SVGGElement>(".layer")];
    let ticking = false;
    const drift = () => {
      ticking = false;
      const y = Math.min(window.scrollY, hero.offsetHeight);
      for (const layer of layers) {
        layer.style.transform = `translateY(${(y * Number(layer.dataset.depth) * 0.35).toFixed(1)}px)`;
      }
    };
    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) requestAnimationFrame(drift);
        ticking = true;
      },
      { passive: true },
    );
  }
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
  }

  .hero-text {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--s-4);
    padding-block: var(--s-7) 0;
  }

  h1 {
    font-size: var(--step-6);
    font-weight: 600;
    font-variation-settings: "SOFT" 100, "WONK" 1;
    line-height: 0.88;
    letter-spacing: -0.035em;
    color: var(--soil);
    max-width: 9ch;
  }

  :lang(kn) h1 {
    font-size: var(--step-5);
    line-height: 1.2;
    letter-spacing: 0;
    max-width: none;
  }

  .tagline {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-style: italic;
    font-weight: 400;
    line-height: 1.25;
    max-width: 24ch;
  }

  :lang(kn) .tagline {
    font-style: normal;
    font-size: var(--step-2);
    line-height: 1.6;
  }

  .days {
    font-size: var(--step-0);
    color: var(--ink-2);
  }

  .count {
    font-weight: 700;
    color: var(--ink);
  }

  /* The sky of the drawing tucks under the last line of text. */
  .scene {
    display: block;
    inline-size: 100%;
    block-size: max(20rem, 38.75vw);
    margin-block-start: calc(clamp(1rem, 4vw, 3.5rem) * -1);
    pointer-events: none;
    --wind: 0deg;
  }

  .layer {
    will-change: transform;
  }

  .sun {
    transition: transform 1.6s var(--ease);
  }

  .grow {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    transition: transform 1.1s var(--ease) var(--d);
  }

  .sway {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    transform: rotate(calc(var(--wind) * var(--k)));
    transition: transform 1.4s var(--ease);
  }

  .unsown .grow {
    transform: scale(0.02);
  }

  .unsown .sun {
    transform: translateY(160px);
  }

  /* Wide: the name on the left, the line under it to its right. */
  @media (min-width: 64rem) {
    .hero-text {
      grid-template-columns: minmax(0, 1fr) minmax(16rem, 24rem);
      column-gap: var(--s-7);
      align-items: end;
      padding-block-start: var(--s-7);
    }

    h1 {
      grid-row: 1 / span 2;
    }

    .tagline,
    .days {
      grid-column: 2;
    }

    .tagline {
      align-self: end;
    }

    .days {
      align-self: start;
      padding-block-end: 0.6rem;
    }
  }
</style>
